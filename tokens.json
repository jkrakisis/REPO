        "info-bg":     { "$value": { "light": "{color.information.5}",  "dark": "{color.information.5}"  }, "$type": "color" },
        "info":        { "$value": { "light": "{color.information.50}", "dark": "{color.information.50}" }, "$type": "color" }
      }
    }
  }
}
